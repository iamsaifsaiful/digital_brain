<?xml version="1.0" encoding="utf-8"?>
<!--
  The reminder icon is named only from Dart ("ic_stat_reminder"), so the
  release build's resource shrinker would otherwise delete it, and Android
  silently drops a notification whose icon is missing.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_stat_reminder,@mipmap/ic_launcher" />
